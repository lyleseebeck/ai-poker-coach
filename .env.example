# Provider adapter to use for the coach endpoint.
COACH_PROVIDER=openrouter

# OpenRouter API key (required for coach requests).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: comma-separated free models only. Every model must include :free.
# If omitted, built-in free fallback models are used.
# COACH_OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,stepfun/step-3.5-flash:free,arcee-ai/trinity-large-preview:free

# Optional: request timeout in ms (default: 25000)
COACH_REQUEST_TIMEOUT_MS=25000

# Optional headers for OpenRouter analytics/ranking
# COACH_SITE_URL=http://localhost:5173
# COACH_APP_NAME=AI Poker Coach

# Required for production internet-facing deployments (Upstash Redis REST).
# Local dev can omit these.
# UPSTASH_REDIS_REST_URL=https://<your-upstash-host>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# Optional production rate limit tuning (defaults shown).
# RATE_LIMIT_COACH_PER_MINUTE=5
# RATE_LIMIT_NORMALIZE_PER_MINUTE=12
